# Copy to .env.local. Anything prefixed with VITE_ is embedded in the public
# JS bundle, so only non-secret values go in VITE_ variables.

# HiveMQ Cloud broker, MQTT over secure WebSockets (port 8884).
VITE_MQTT_URL=wss://<cluster-id>.s1.eu.hivemq.cloud:8884/mqtt

# Root of every topic used by this project. Keeps it apart from other
# projects on the same broker (robotcell/..., device/<id>/...).
VITE_TOPIC_PREFIX=accelerometer

# Only read by bridge/make_kit.py to write config.bat in the lab PC kit.
# Never used by the website. Leave the password empty to have the kit ask for it.
BRIDGE_MQTT_USERNAME=
BRIDGE_MQTT_PASSWORD=
